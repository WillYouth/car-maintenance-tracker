# Copy to .env (chmod 600) and fill in. Loaded by systemd (EnvironmentFile) or `node --env-file=.env`.

PORT=3000
PUBLIC_URL=https://cars.example.com
DB_PATH=data/app.db
UPLOAD_DIR=data/uploads
COOKIE_SECURE=true

# Google Gemini API key (https://aistudio.google.com/app/apikey), used with gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram alerts (optional). Create a bot with @BotFather, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts (optional). Any SMTP relay works: SendGrid, Brevo, Gmail app password, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Car Tracker <alerts@example.com>"
